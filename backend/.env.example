# ============================================
# ORION - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys.
#
# LLM — Anthropic Messages API
# ──────────────────────────────────────────
# Get a key from your Aerolink dashboard: https://aerolink.lat/dashboard/api-keys
LLM_API_KEY=your_api_key_here

# Base URL for the Anthropic-compatible endpoint.
LLM_BASE_URL=https://api.aerolink.lat/v1

# Claude model. Available: claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-5

# Per-request timeout in seconds. Long-form drafting can run several minutes.
LLM_TIMEOUT_SECONDS=600

# Reasoning effort when thinking is enabled: low, medium, or high.
LLM_THINKING_EFFORT=medium

# Tavily Web Search API (optional but recommended)
# Get a key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Optional Configuration
# ============================================
# ChromaDB persistence directory (default: ./chroma_data)
CHROMA_PERSIST_DIR=./chroma_data

# SQLite checkpoint path for LangGraph state persistence
SQLITE_CHECKPOINT_PATH=./orion_checkpoints.db

# Session metadata/results local persistence file
SESSION_STORE_PATH=./orion_sessions.json

# Retrieval tuning
MAX_SEARCH_QUERIES=4
MAX_SOURCE_RESULTS_PER_QUERY=4
SEMANTIC_SCHOLAR_MAX_RETRIES=3
SEMANTIC_SCHOLAR_BASE_BACKOFF_SECONDS=2.0
MAX_DEBATE_ROUNDS=1
STRICT_SYNTHESIS_MODE=false

# Contact email sent to Crossref for polite-pool access. Leave blank to omit.
CROSSREF_CONTACT_EMAIL=

# Server settings
HOST=0.0.0.0
PORT=8000
